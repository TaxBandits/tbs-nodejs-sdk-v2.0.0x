# TaxBandits API configuration
# IMPORTANT: Do not commit actual credentials or secrets to source control.
# Configure these values through environment variables or a secure secret manager.

# API Base URL for TaxBandits
PUBLIC_API_URL="https://testapi.taxbandits.com/v2.0.0"

# OAuth Base URL for authentication
OAUTH_URL="https://testoauth.expressauth.net/v2"

# Client ID from API credentials
OAUTH_CLIENT_ID="<YOUR_OAUTH_CLIENT_ID>"

# Client Secret from API credentials
OAUTH_CLIENT_SECRET="<YOUR_OAUTH_CLIENT_SECRET>"

# User Token from API credentials
OAUTH_USER_TOKEN="<YOUR_OAUTH_USER_TOKEN>"

# AWS S3 configuration for the draft PDF SSE-C proxy
S3_ACCESS_KEY="<YOUR_S3_ACCESS_KEY>"
S3_SECRET_KEY="<YOUR_S3_SECRET_KEY>"
S3_BUCKET_NAME="expressirsforms"
S3_BASE64_KEY="<YOUR_S3_BASE64_KEY>"
S3_REGION="us-east-1"